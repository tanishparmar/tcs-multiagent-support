# No API key required — uses local Ollama LLM (free)

# Ollama model to use (must be pulled first: ollama pull llama3.2)
LLM_MODEL=llama3.2

# Embedding model (downloaded automatically via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# MCP server (optional)
MCP_HOST=localhost
MCP_PORT=8765
